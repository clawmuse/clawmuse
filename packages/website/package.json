{
  "name": "@getpaseo/website",
  "version": "1.5.5+1108",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "dev:clawmuse": "vite --config clawmuse/vite.config.ts",
    "build:clawmuse": "npm run demo:sync && npm run changelog:sync && npm run brand:clawmuse && vite build --config clawmuse/vite.config.ts && node clawmuse/build.mjs",
    "demo:sync": "node clawmuse/sync-demo-labels.mjs",
    "changelog:sync": "node clawmuse/sync-changelog.mjs",
    "brand:clawmuse": "node clawmuse/generate-brand.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.29.1",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@getpaseo/protocol": "*",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "framer-motion": "^12.35.2",
    "github-slugger": "^2.0.0",
    "i18next": "^26.5.6",
    "lucide-react": "^1.7.0",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "react-i18next": "^17.1.3",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "wrangler": "^4.75.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "esbuild": "^0.27.3",
    "parse5": "^7.3.0",
    "sharp": "0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.6"
  }
}
